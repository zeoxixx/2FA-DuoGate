<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/splashFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">
        <!-- 텍스트 추가 -->
        <TextView
            android:id="@+id/doorLockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center"
            android:layout_marginTop="100dp"
            android:text="2FA Access System"
            android:fontFamily="@font/mb_l"
            android:textColor="#1E3D32"
            android:textSize="35sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/doorImageView"
            android:layout_width="270dp"
            android:layout_height="317dp"
            android:layout_gravity="center"
            android:src="@drawable/door_lock" />

        <View
            android:id="@+id/blackOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

