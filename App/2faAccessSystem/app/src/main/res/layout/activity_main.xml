<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- 상단 회색 타이틀바 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3D32">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="2FA 출입인증 시스템"
            android:fontFamily="@font/neo_a"
            android:textColor="#D8CAB8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMyPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:background="@android:color/transparent"
            android:text="☰"
            android:textColor="#D8CAB8"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- 본문 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- 인증 성공 메시지 -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1차 인증이 완료되었습니다\n출입을 시도하세요"
            android:fontFamily="@font/neo_b"
            android:textAlignment="center"
            android:textSize="18sp"
            android:layout_marginBottom="32dp"
            android:visibility="visible" />

        <!-- 인증 실패 메시지 -->
        <TextView
            android:id="@+id/tvFail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1차 인증이 되지 않았습니다.\n다시 시도하세요"
            android:textAlignment="center"
            android:textSize="18sp"
            android:layout_marginBottom="32dp"
            android:visibility="gone" />

        <!-- 출입 버튼 -->
        <Button
            android:id="@+id/btnEnter"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:text="출입하기"
            android:fontFamily="@font/neo_b"
            android:textColor="#D8CAB8"
            android:textSize="18sp"
            android:backgroundTint="#1E3D32"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:visibility="visible" />


    </LinearLayout>
</LinearLayout>
