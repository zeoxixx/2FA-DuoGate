<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- 상단 타이틀바 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3D32">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="2FA 출입인증 시스템"
            android:fontFamily="@font/neo_a"
            android:textColor="#D8CAB8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMyPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:background="@android:color/transparent"
            android:text="☰"
            android:textColor="#D8CAB8"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- 본문 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/padlockImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="3dp"
            android:contentDescription="자물쇠 아이콘"
            android:src="@drawable/ic_lock_close"
            app:tint="#1E3D32" />

        <TextView
            android:id="@+id/tvAccessDenied"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="출입이 거부되었습니다"
            android:fontFamily="@font/neo_b"
            android:textColor="#D32F2F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1E3D32"
            android:paddingLeft="24dp"
            android:paddingTop="10dp"
            android:paddingRight="24dp"
            android:paddingBottom="10dp"
            android:text="다시 시도하기"
            android:fontFamily="@font/neo_b"
            android:textColor="#D8CAB8"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>
