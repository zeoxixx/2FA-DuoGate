<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3D32">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2FA 출입인증 시스템"
            android:fontFamily="@font/neo_a"
            android:textColor="#D8CAB8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <Button
            android:id="@+id/btnMyPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:background="@android:color/transparent"
            android:textColor="#D8CAB8"
            android:text="☰"
            android:textSize="20sp" />
    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:gravity="top|center_horizontal">

    <TextView
        android:text="간편 로그인용 PIN 6자리를 입력하세요"
        android:fontFamily="@font/neo_c"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/editPin1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="PIN 입력"
        android:inputType="numberPassword"
        android:maxLength="6"/>

    <EditText
        android:id="@+id/editPin2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="PIN 재입력"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnRegisterPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="등록"
        android:textColor="#D8CAB8"
        android:textSize="18sp"
        android:backgroundTint="#1E3D32"
        android:layout_marginTop="24dp"/>

    </LinearLayout>
</LinearLayout>
